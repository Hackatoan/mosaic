NODE_ENV=development

# Public base URL, used for SEO metadata (canonical/OG URLs) and sitemap.
NEXT_PUBLIC_SITE_URL=https://mosaic.hackatoa.com

# Optional. Free API key from https://www.pexels.com/api/ — enables the
# "auto-fetch tiles from a topic" mode. Without it, that mode is hidden in
# the UI and /api/generate rejects requests using the 'topic' field with a
# clear "not configured" error; upload-your-own-tiles still works fine.
PEXELS_API_KEY=

# Upload + generation limits (all optional, sane defaults are baked in)
MOSAIC_MAX_SOURCE_MB=10
MOSAIC_MAX_TILE_MB=5
MOSAIC_MAX_TILES=120
MOSAIC_MIN_TILES=3
MOSAIC_DEFAULT_TOPIC_TILES=40

# Simple in-memory per-IP rate limit for the public /api/generate endpoint.
# NOTE: resets on container restart and is per-instance (fine for a single
# container behind Watchtower; wouldn't hold up behind a multi-replica setup).
MOSAIC_RATE_LIMIT_MAX=12
MOSAIC_RATE_LIMIT_WINDOW_MS=600000
